{
  "name": "tfecat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "dev:make": "vite --base / --host :: --port ${PORT:-3000}",
    "build": "vue-tsc && vite build",
    "build:make": "vue-tsc && vite build --base / --mode development",
    "preview": "vite preview",
    "deploy": "pnpm run build && gh-pages -d dist",
    "update": "pnpm run update-trainers && pnpm run update-customs && pnpm run update-catalog && pnpm run update-summary",
    "update-trainers": "curl -fsS http://vault-thirteen.net:49160/trainers -o ./public/trainers.json",
    "update-customs": "curl -fsS http://vault-thirteen.net:49160/customs -o ./public/customs.json",
    "update-catalog": "curl -fsS http://vault-thirteen.net:49160/catalog -o ./public/catalog.json",
    "update-summary": "curl -fsS http://vault-thirteen.net:49160/catalog/summary -o ./public/summary.json",
    "server": "node ./server/app.js"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.10.0",
    "express": "^5.1.0",
    "got": "^16.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "gh-pages": "^6.3.0",
    "only-allow": "^1.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "minimumReleaseAgeExclude": [
      "got@16.2.0"
    ]
  }
}
